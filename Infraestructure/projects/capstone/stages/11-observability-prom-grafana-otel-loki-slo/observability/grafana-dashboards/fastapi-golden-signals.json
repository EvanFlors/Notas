{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Capstone FastAPI Golden Signals + Error Budget. Four core panels (latency, traffic, errors, saturation) plus error budget burn-rate.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "capstone-golden-signals",
  "title": "Capstone FastAPI — Golden Signals",
  "tags": ["capstone", "slo", "fastapi"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, service)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "selected": true, "text": "capstone-api", "value": "capstone-api" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "title": "Traffic (req/s by handler)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total{service=\"$service\"}[5m]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors (5xx ratio)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.001 },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "slo:http_requests_error_ratio:rate5m{service=\"$service\"}",
          "legendFormat": "5m error ratio",
          "refId": "A"
        },
        {
          "expr": "slo:http_requests_error_ratio:rate1h{service=\"$service\"}",
          "legendFormat": "1h error ratio",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Saturation (CPU + memory of the API pods)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"capstone\",container=\"capstone-api\"}[5m])) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"capstone\",container=\"capstone-api\",resource=\"cpu\"})",
          "legendFormat": "cpu {{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"capstone\",container=\"capstone-api\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"capstone\",container=\"capstone-api\",resource=\"memory\"})",
          "legendFormat": "mem {{pod}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error budget remaining (30d, SLO=99.9%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "1 - (slo:http_requests_error_ratio:rate3d{service=\"$service\"} / 0.001)",
          "legendFormat": "budget left",
          "refId": "A"
        }
      ]
    }
  ]
}
