events {
  worker_connections 1024;
}

http {
  upstream app {
    server 127.0.0.1:{{ webserver_upstream_port }};
  }

  server {
    listen {{ webserver_port }};
    server_name {{ webserver_server_name }};

    location / {
      proxy_pass http://app;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
    }
  }
}
