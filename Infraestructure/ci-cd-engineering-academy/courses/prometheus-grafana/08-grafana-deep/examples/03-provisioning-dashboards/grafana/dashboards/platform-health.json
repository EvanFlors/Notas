{
  "uid": "platform-health",
  "title": "Platform health",
  "tags": ["platform"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets UP",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(up)"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "up por instance",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 6, "w": 16, "x": 8, "y": 0},
      "targets": [{"refId": "A", "expr": "up", "legendFormat": "{{job}} {{instance}}"}]
    }
  ]
}
