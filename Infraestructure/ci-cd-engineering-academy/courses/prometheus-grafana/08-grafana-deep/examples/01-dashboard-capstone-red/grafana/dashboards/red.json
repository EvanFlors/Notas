{
  "uid": "capstone-red-demo",
  "title": "RED — capstone (demo)",
  "tags": ["capstone", "red"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prom-main"},
        "query": "label_values(up, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate — requests/s por handler",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler) (rate(prometheus_http_requests_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate (ratio)",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prometheus_http_requests_total{code=~\"5..\",job=~\"$job\"}[$__rate_interval])) / clamp_min(sum(rate(prometheus_http_requests_total{job=~\"$job\"}[$__rate_interval])), 1)"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Latencia p95 (s)",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prometheus_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Distribución latencia",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(prometheus_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top 10 handlers por p95",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (handler, le) (rate(prometheus_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "up por target",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"$job\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}}]}, "overrides": []}
    }
  ]
}
