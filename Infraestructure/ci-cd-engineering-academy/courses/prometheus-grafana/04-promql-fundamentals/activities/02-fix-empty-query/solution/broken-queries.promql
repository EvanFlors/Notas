# === Query 1 ===
# Original:
rate(http_request_total{job="api"}[5m])
# Hipótesis: nombre de métrica incorrecto (falta _total)
# Fix:
rate(http_requests_total{job="api"}[5m])

# === Query 2 ===
# Original:
sum by (endpoint) (rate(http_requests_total[5m]))
# Hipótesis: label incorrecta — la real es `path`, no `endpoint`
# Fix:
sum by (path) (rate(http_requests_total[5m]))

# === Query 3 ===
# Original (scrape_interval=15s):
rate(http_requests_total[10s])
# Hipótesis: ventana < 2 muestras — subir a ≥ 4 × scrape_interval
# Fix:
rate(http_requests_total[1m])

# === Query 4 ===
# Original:
rate(node_memory_MemFree_bytes[5m])
# Hipótesis: rate sobre un gauge — usar deriv o *_over_time
# Fix:
avg_over_time(node_memory_MemFree_bytes[5m])

# === Query 5 ===
# Original:
histogram_quantile(0.95, sum by (job) (rate(http_request_duration_seconds_bucket[5m])))
# Hipótesis: falta `le` en el by de histogram_quantile
# Fix:
histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))
