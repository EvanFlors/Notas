{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowVendorWithExternalId",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::999999999999:root"},
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "replace-with-long-random-secret-shared-with-vendor"
        }
      }
    }
  ]
}
