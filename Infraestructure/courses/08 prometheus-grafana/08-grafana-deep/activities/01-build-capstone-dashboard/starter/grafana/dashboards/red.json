{
  "uid": "capstone-red",
  "title": "RED — capstone",
  "tags": ["capstone", "red"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate — requests/s",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler) (rate(prometheus_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error ratio",
      "datasource": {"type": "prometheus", "uid": "prom-main"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prometheus_http_requests_total{code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(prometheus_http_requests_total[$__rate_interval])), 1)"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}
    }
  ]
}
