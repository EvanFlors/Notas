{
  "uid": "capstone-red",
  "title": "RED — capstone",
  "tags": ["capstone", "red"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {"name": "job", "type": "query", "query": "label_values(up, job)", "includeAll": true, "multi": true},
      {"name": "interval", "type": "custom", "query": "1m,5m,15m,1h"}
    ]
  },
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Rate", "expr": "sum by (handler) (rate(prometheus_http_requests_total{job=~\"$job\"}[$__rate_interval]))"},
    {"id": 2, "type": "stat", "title": "Error ratio", "expr": "sum(rate(prometheus_http_requests_total{code=~\"5..\",job=~\"$job\"}[$__rate_interval])) / clamp_min(sum(rate(prometheus_http_requests_total{job=~\"$job\"}[$__rate_interval])), 1)"},
    {"id": 3, "type": "gauge", "title": "p95 latency", "expr": "histogram_quantile(0.95, sum by (le) (rate(prometheus_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))"},
    {"id": 4, "type": "heatmap", "title": "Latency distribution", "expr": "sum by (le) (rate(prometheus_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))"},
    {"id": 5, "type": "table", "title": "Top 10 handlers by p95", "expr": "topk(10, histogram_quantile(0.95, sum by (handler, le) (rate(prometheus_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))))"},
    {"id": 6, "type": "state-timeline", "title": "up por target", "expr": "up{job=~\"$job\"}"}
  ]
}
