# /etc/cron.d/backup — crontab heredado a migrar
#
# Objetivo: backup diario de /srv/data a /var/backups/data, 02:30, como root,
# con el PATH mínimo del sistema y logs a /var/log/backup.log.

PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=sysadmin@example.com

# m  h  dom mon dow  user  command
30   2  *   *   *    root  /usr/local/bin/backup.sh --target /srv/data --dest /var/backups/data >> /var/log/backup.log 2>&1
