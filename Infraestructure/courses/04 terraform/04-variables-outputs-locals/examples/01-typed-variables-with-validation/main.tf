locals {
  name_prefix = "${var.service.name}-${var.environment}"

  base_tags = {
    environment = var.environment
    team        = var.service.team
    managed_by  = "terraform"
  }
  effective_tags = merge(local.base_tags, var.service.tags)
}

resource "random_pet" "name" {
  length    = var.pet_length
  separator = "-"
  prefix    = local.name_prefix
}

resource "local_file" "manifest" {
  filename        = "${path.module}/out/${local.name_prefix}.txt"
  file_permission = "0644"
  content = <<-EOT
    # Manifest generated by terraform
    name            = ${random_pet.name.id}
    environment     = ${var.environment}
    team            = ${var.service.team}
    enable_metrics  = ${var.feature_flags.enable_metrics}
    enable_tracing  = ${var.feature_flags.enable_tracing}
    effective_tags  = ${jsonencode(local.effective_tags)}
  EOT
}
