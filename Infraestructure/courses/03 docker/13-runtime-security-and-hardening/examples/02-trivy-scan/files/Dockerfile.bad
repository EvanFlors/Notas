# Intentionally bad: runs as root, uses latest, no HEALTHCHECK.
# Used to show what Trivy flags via `trivy config`.
FROM python:latest

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=busybox:latest /bin/busybox /usr/local/bin/busybox

CMD ["python", "-c", "print('bad')"]
