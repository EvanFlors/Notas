{
  "expo": {
    "name": "06_native_features",
    "slug": "06_native_features",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.efloresp06.nativefeatures"
    },
    "android": {
      "package": "com.efloresp06.nativefeatures",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "The app needs access to your camera in order to take photos of your favorite places.",
          "photosPermission": "The app needs access to your photos in order to let you pick a picture of your favorite places."
        }
      ],
      "expo-asset",
      "expo-sqlite"
    ]
  }
}
